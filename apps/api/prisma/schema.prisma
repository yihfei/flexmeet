generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Add your models here (events, participants, availability, ...), then run:
//   pnpm --filter @flexmeet/api prisma migrate dev --name <change>
model Event {
  id              Int           @id @default(autoincrement())
  slug            String        @unique @db.VarChar(16)
  title           String        @db.VarChar(100)
  dates           DateTime[]    @db.Date
  startMinute     Int // minutes after local midnight: 540 = 09:00
  endMinute       Int // exclusive: 1020 = the grid stops at 17:00
  slotMinutes     Int           @default(30)
  durationMinutes Int?
  timezone        String // IANA name, e.g. "Asia/Singapore"
  participants    Participant[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// A person who answered an event. No accounts: a name is unique within one event only.
model Participant {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(50)
  slots     String[] // slot keys in the event's timezone, e.g. "2026-10-10T09:30"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
}
